{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pointapp-builder",
  "account_id": "bc890091d86ddf9ce669e96e79d47746",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "appbuilder.pointatx.org",
      "custom_domain": true,
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/content/*"],
  },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_VERSION": "0.1.0",
    "BUILDER_ORIGIN": "https://appbuilder.pointatx.org",
    "AUTHENTICATION_ENABLED": "true",
    "PUBLISHING_ENABLED": "true",
    "BOOTSTRAP_OWNER_GITHUB_ID": "1202831",
    "REGISTRATION_POLICY": "verified-github",
    "SIGNING_KEY_ID": "pointapp-2026-01",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pointapp-builder",
      "database_id": "9514b157-7e95-401e-9a93-0a5ee120c7fe",
    },
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "484310401",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "MUTATION_RATE_LIMITER",
      "namespace_id": "484310402",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
