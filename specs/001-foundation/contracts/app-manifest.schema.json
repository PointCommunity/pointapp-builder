{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pointatx.org/contracts/pointapp/manifest-v1.schema.json",
  "title": "PointApp content manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "appId",
    "revision",
    "channel",
    "updatedAt",
    "brand",
    "navigation",
    "screens",
    "assets"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "appId": { "$ref": "#/$defs/identifier" },
    "revision": { "type": "integer", "minimum": 1 },
    "channel": { "enum": ["draft", "staging", "production"] },
    "updatedAt": { "type": "string", "format": "date-time" },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "shortName", "accent", "surface"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "shortName": { "type": "string", "minLength": 1, "maxLength": 18 },
        "accent": { "$ref": "#/$defs/color" },
        "surface": { "$ref": "#/$defs/color" }
      }
    },
    "navigation": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "icon", "screenId"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "label": { "type": "string", "minLength": 1, "maxLength": 20 },
          "icon": { "enum": ["home", "calendar", "play", "people", "more"] },
          "screenId": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "elements"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "elements": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/element" } }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "url"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "kind": { "enum": ["image", "audio", "video"] },
          "url": { "type": "string", "format": "uri" },
          "alt": { "type": "string", "maxLength": 240 }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "element": {
      "oneOf": [
        { "$ref": "#/$defs/hero" },
        { "$ref": "#/$defs/text" },
        { "$ref": "#/$defs/action" },
        { "$ref": "#/$defs/media" },
        { "$ref": "#/$defs/eventList" },
        { "$ref": "#/$defs/divider" }
      ]
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "hero" },
        "eyebrow": { "type": "string", "maxLength": 60 },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "body": { "type": "string", "maxLength": 280 },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "href"],
          "properties": {
            "label": { "type": "string", "minLength": 1, "maxLength": 40 },
            "href": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "body"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "text" },
        "body": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "style": { "enum": ["body", "lead", "caption"], "default": "body" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "href"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "action" },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "href": { "type": "string", "minLength": 1, "maxLength": 500 },
        "appearance": { "enum": ["primary", "secondary", "quiet"], "default": "primary" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "assetId", "alt"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "media" },
        "assetId": { "$ref": "#/$defs/identifier" },
        "alt": { "type": "string", "minLength": 1, "maxLength": 240 },
        "aspect": { "enum": ["square", "portrait", "landscape", "wide"], "default": "landscape" }
      }
    },
    "eventList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "sourceId"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": { "const": "event-list" },
        "sourceId": { "$ref": "#/$defs/identifier" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 20, "default": 6 }
      }
    },
    "divider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": { "id": { "$ref": "#/$defs/identifier" }, "type": { "const": "divider" } }
    }
  }
}
